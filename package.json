{
  "dependencies": {
    "@interview-web/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@interview-web/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "name": "interview-web",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "db:generate": "turbo run db:generate -F @interview-web/db",
    "deploy": "turbo run deploy -F @interview-web/infra",
    "destroy": "turbo run destroy -F @interview-web/infra"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "packageManager": "pnpm@11.21.0"
}
