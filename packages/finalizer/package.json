{
  "name": "@interview-web/finalizer",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node output/server.cjs",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --outfile=output/server.cjs --packages=bundle",
    "test": "vitest run",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "docker:build": "docker build --platform linux/amd64 -t recording-finalizer ."
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@interview-web/db": "workspace:*",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "^0.30.0",
    "esbuild": "^0.25.12",
    "@interview-web/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
